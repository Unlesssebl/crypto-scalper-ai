# HyperData Terminal — Environment Configuration
# Copy this file to .env and fill in the values you need.

# ── LLM Trading Agent ─────────────────────────────────────
# Any OpenAI-compatible API works: OpenAI, Ollama, LM Studio, Groq, Together, etc.
# For Ollama (local): LLM_BASE_URL=http://localhost:11434/v1
# For OpenAI:         LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...

# ── Alert Notifications (optional) ────────────────────────
# Telegram: message @BotFather, send /newbot, copy the token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: create a webhook in channel settings
DISCORD_WEBHOOK_URL=

# ── Native API + external screener ───────────────────────────────
# `hyperdata api` prefetches this many top-volume symbols before starting the
# orderflow shard plan (default 60; the plan is fixed at start()).
HYPERDATA_UNIVERSE_LIMIT=60
# The external screener reads this API. Loopback needs no key.
HYPERDATA_API_URL=http://127.0.0.1:8420
# Screener journal directory; keep it separate from HYPERDATA_DATA_DIR.
HYPERDATA_SCREENER_DATA_DIR=
# Interval (seconds) between unsolicited Telegram market digests when --notify
# is on (default 0 = disabled). The screener skips a digest when the market context is
# empty or the hub has no configured chat.
HYPERDATA_DIGEST_SECONDS=0
# Minimum finding strength that triggers a Telegram alert: 1 background,
# 3 strong (default), 4 critical. Early opportunities have separate eligibility.
HYPERDATA_ALERT_MIN_RANK=3

# ── REST API exposure (see README "REST API" security note) ─────
# Loopback (127.0.0.1) needs no key. A non-loopback bind is refused unless
# HYPERDATA_API_KEY is set (auth required on all non-health routes) or
# HYPERDATA_UNSAFE_PUBLIC_API=1 explicitly accepts unauthenticated exposure.
# Browsers get NO cross-origin access on any bind unless the page's origin is
# listed in HYPERDATA_CORS_ORIGINS (comma-separated); the same list gates
# WebSocket upgrades. curl/SDK clients are unaffected.
HYPERDATA_API_HOST=127.0.0.1
HYPERDATA_API_KEY=
HYPERDATA_CORS_ORIGINS=
HYPERDATA_UNSAFE_PUBLIC_API=

# ── LLM cost guardrail ────────────────────────────────────
# Max LLM strategy evaluations per hour (default 60).
LLM_MAX_EVALS_PER_HOUR=60

# Crypto Scalper AI (choose gemini or openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROXY=
# HYPERDATA_DATA_DIR=.runtime

# Opportunity Filter: initial defaults; Dashboard changes persist in SQLite.
SCALPER_AI_MODE=balanced
SCALPER_AI_HOURLY_LIMIT=40
SCALPER_AI_COOLDOWN_SECONDS=300
SCALPER_AI_EARLY=true
SCALPER_AI_EXPERIMENTS=false
# Selective interpretation of substantial episode context changes (shared AI budget).
SCALPER_CONTEXT_AUTO=true

# Selective attention: all available market aggregates, detailed streams only
# on a relative anomaly. No Top-20 or absolute-volume ranking. Live Hub only.
HYPERDATA_ATTENTION_ENABLED=1
HYPERDATA_ATTENTION_SLOTS=6
# Empty uses the user-data directory, not the repository.
HYPERDATA_HISTORY_DIR=

# Unified launcher enables PULSE_UNIFIED in its child processes.
SCALPER_FREE_ENABLED=true
SCALPER_FREE_MODEL=nvidia/nemotron-3.5-super-vl:free
SCALPER_ATTENTION_SLOTS=20
PULSE_ATTENTION_DETAIL_SLOTS=6
HYPERDATA_HISTORY_MAX_BYTES=5368709120

# Telegram product UX. Analytics must be a separate destination from TELEGRAM_CHAT_ID.
SCALPER_TELEGRAM_UX=1
SCALPER_ANALYTICS_CHAT_ID=
# User IDs admitted for terminal actions and manual analysis in groups.
# The owner of the private operational chat is admitted automatically.
SCALPER_TELEGRAM_OPERATOR_IDS=
SCALPER_TIGER_WS_URL=ws://127.0.0.1:7819/
SCALPER_TIGER_EXCHANGE=BINANCE-FUT
SCALPER_TIGER_MARKET=FUTURES
SCALPER_TIGER_LINK_GROUP=S
# Optional exact aliases: {"kPEPE":"1000PEPEUSDT"}; verify in Tiger first.
SCALPER_TIGER_SYMBOLS={}
