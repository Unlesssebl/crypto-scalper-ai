# Crypto Scalper — единый контур наблюдения
# Скопируйте в .env. Строки с # не загружаются.
# Приоритеты, пути и ограничения: docs/configuration.md.

# Каталоги Binance USDT-M и Hyperliquid, до 20 снимков, 6 подробных потоков.
# Список инструментов не задаётся: подписками управляет общий adaptive attention.
HYPERDATA_API_URL=http://127.0.0.1:8420
# HTTP/HTTPS-прокси только для бирж; пусто = прямое соединение.
# Пример: http://USER:PASSWORD@HOST:PORT (спецсимволы в логине/пароле URL-encoded).
# Локальный API/ingest, Telegram и AI через этот прокси не проходят.
HYPERDATA_EXCHANGE_PROXY=
PULSE_API_URL=http://127.0.0.1:8431
# Историческая оценка качества в фоне, без второго автора attention.
PULSE_SHADOW=1
SCALPER_ATTENTION_SLOTS=20
PULSE_ATTENTION_DETAIL_SLOTS=6
# Защита до двух focus-эпизодов для накопления контекста.
# Допустимо 60..3600; фактический минимум — 330 секунд.
# Это не максимальная длительность каждого наблюдения и не lease плана.
PULSE_ATTENTION_HOLD_SECONDS=600

# Пусто = штатные пользовательские каталоги. Смена пути требует переноса данных.
HYPERDATA_SCREENER_DATA_DIR=
HYPERDATA_HISTORY_DIR=
# Общий бюджет native history + решений attention; срок хранения 48 часов.
HYPERDATA_HISTORY_MAX_BYTES=5368709120
# HYPERDATA_DATA_DIR=
# PostgreSQL и Pulse raw используют отдельные Docker volumes.
# deploy/market-pulse/.env создаётся launcher со случайными секретами.

# Контекстный AI. Политика из панели сохраняется в SQLite и имеет приоритет
# над начальными лимитами ниже. Общий платный потолок — 40/час, включая meta/manual.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Введите выбранную вами основную модель. Пусто = платный AI выключен.
OPENROUTER_MODEL=
# OPENROUTER_PROXY=
SCALPER_CONTEXT_AUTO=true
SCALPER_AI_HOURLY_LIMIT=40
SCALPER_AI_COOLDOWN_SECONDS=300
# Парные экспериментальные запросы в едином контуре всегда отключены.
SCALPER_AI_EXPERIMENTS=false
# Бесплатный маршрут: проверка нулевой цены, 12/час, 40/сутки, без платного fallback.
SCALPER_FREE_ENABLED=true
SCALPER_FREE_MODEL=nvidia/nemotron-3.5-super-vl:free

# Telegram включается флагом запуска --notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SCALPER_TELEGRAM_UX=1
# Отдельное назначение аналитики, если нужно; не дублируйте TELEGRAM_CHAT_ID.
SCALPER_ANALYTICS_CHAT_ID=
SCALPER_TELEGRAM_OPERATOR_IDS=
# Старый digest не используется Telegram UX.
# HYPERDATA_DIGEST_SECONDS=0
# DISCORD_WEBHOOK_URL=

# Переход в установленный и настроенный Tiger.
SCALPER_TIGER_WS_URL=ws://127.0.0.1:7819/
SCALPER_TIGER_EXCHANGE=BINANCE-FUT
SCALPER_TIGER_MARKET=FUTURES
SCALPER_TIGER_LINK_GROUP=S
# Только проверенные точные соответствия, например {"kPEPE":"1000PEPEUSDT"}.
SCALPER_TIGER_SYMBOLS={}
# Новые Telegram-боты (docs/multi-bot-plan.md): создать в @BotFather; без токена бот молчит.
SCALPER_MOVERS_BOT_TOKEN=
SCALPER_MOVERS_CHAT_ID=
SCALPER_LEVELS_BOT_TOKEN=
SCALPER_LEVELS_CHAT_ID=
# Места подробного наблюдения для ликвидных движений сверх мест аномалий (всего не больше 8).
SCALPER_MOVERS_SLOTS=2
# Уведомления Windows по отобранным карточкам; клик открывает тикер в Tiger.
# Группа — та, к которой привязаны основной график и стакан (по умолчанию SCALPER_TIGER_LINK_GROUP).
SCALPER_DESKTOP_NOTIFY=0
# SCALPER_TIGER_NOTIFY_GROUP=A

# Локальный API. Настройка удалённого доступа описана в README.
HYPERDATA_API_HOST=127.0.0.1
HYPERDATA_API_KEY=
HYPERDATA_CORS_ORIGINS=
# HYPERDATA_UNSAFE_PUBLIC_API=1

# Альтернативный провайдер: замените AI_PROVIDER на gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_API_KEY_1..10 текущий runtime не читает и не ротирует.

# Совместимость со старым directional-фильтром и его интерфейсом.
# В unified-контуре mode/early не управляют attention и AI-маршрутами.
# SCALPER_AI_MODE=balanced
# SCALPER_AI_EARLY=true

# Отдельные команды исходного HyperData, а не единый контур.
# HYPERDATA_UNIVERSE_LIMIT=60
# Только paper-стратегия llm_agent, не контекстный AI:
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_MAX_EVALS_PER_HOUR=60
